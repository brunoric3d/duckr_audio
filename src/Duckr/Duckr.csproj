<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Duckr</AssemblyName>
    <RootNamespace>Duckr</RootNamespace>
    <ApplicationIcon>Assets\duckr.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Duckr</Product>
    <Description>Lowers your music while your work app plays.</Description>
    <Copyright>Licensed under GNU GPL v3</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- installer: one-click Setup.exe, per-user install (see make-installer.bat) -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\duckr_on.ico" LogicalName="duckr_on.ico" />
    <EmbeddedResource Include="Assets\duckr_ducking.ico" LogicalName="duckr_ducking.ico" />
    <EmbeddedResource Include="Assets\duckr_off.ico" LogicalName="duckr_off.ico" />
  </ItemGroup>

</Project>
